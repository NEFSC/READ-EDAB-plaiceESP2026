dplyr::filter(Year >= 1970) |>
dplyr::filter(Month %in% 4:9) |>
dplyr::group_by(Year) |>
dplyr::summarize(DATA_VALUE = mean(Value, na.rm = TRUE)) |>
dplyr::rename(YEAR = Year) |>
dplyr::mutate(INDICATOR_NAME = "fall_amo")
