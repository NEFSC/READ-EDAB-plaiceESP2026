dplyr::filter(YEAR %in% 1970:2025) |>
dplyr::group_by(YEAR) |>
dplyr::mutate(Season_Start_Year = ifelse(MONTH %in% c(1:2), YEAR - 1, YEAR)) |>
dplyr::ungroup() |>
