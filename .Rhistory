format_tbl_data <- function(file,
dir) {
if(stringr::str_detect(file, "csv$")) {
out <- read.csv(file)
} else if(stringr::str_detect(file, "xlsx$")) {
out <- readxl::read_excel(file)
} else {
stop("File must be a .csv or .xlsx")
}
output <- out |>
janitor::clean_names() |>
dplyr::mutate(figure =  paste0(dir, "/", .data$time_series)) |>
dplyr::select(-.data$time_series)
return(output)
}
knitr::opts_chunk$set(echo = FALSE)
data1 <- format_tbl_data(file = params$tbl_file,
dir = params$img_dir)
NEesp2::rpt_card_table(data1,
widths = params$widths)
