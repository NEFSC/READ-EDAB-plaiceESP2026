dplyr::filter(YEAR %in% 1970:2025) |>
dplyr::filter(MONTH %in% 3:8) |>
dplyr::group_by(YEAR) |>
dplyr::summarize(DATA_VALUE = mean(DATA_VALUE, na.rm = TRUE)) |>
