create_shp <- function(strata, orig_shp = shp) {
shp_out <- orig_shp[orig_shp$STRATUMA %in% strata, ] |>
terra::aggregate()
# add dummy attribute so it works with edab_utils
shp_out$region <- "stock_area"
return(shp_out)
}
